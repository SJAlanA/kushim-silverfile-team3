# Copy to .env and fill in. Never commit .env.
# Everything works with this file unchanged: no API key means offline, rule-based mode.

# --- Model (src/llm.py) ---
ANTHROPIC_API_KEY=
MODEL_NAME=claude-sonnet-5-5
# 1 forces offline mode even when a key is set. Docker defaults to 1; set 0 to use Claude there.
SILVERFILE_OFFLINE=

# --- State and resumability (src/memory.py) ---
CHECKPOINT_DB=silverfile_checkpoints.sqlite

# --- Orchestration bounds (src/agents/orchestrator.py) ---
MAX_REVIEW_ITERATIONS=3
MAX_HOPS=60

# --- Dashboard (run.py --dashboard, src/dashboard/) ---
# 127.0.0.1 locally; Docker sets 0.0.0.0 so the port can be published.
DASHBOARD_HOST=127.0.0.1
# Signs the dashboard session cookie. Leave empty for a random one per start.
DASHBOARD_SECRET=

# --- tax_math (src/tools/) ---
# 1 calls the tax_math functions in-process instead of over MCP stdio (tests set this).
TAX_MATH_INPROCESS=
# Where per-session JSONL traces are written.
SILVERFILE_TRACE_DIR=traces
